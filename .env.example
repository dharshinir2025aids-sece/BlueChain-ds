# BlueChain MRV — Environment Template
# Copy to .env and fill in values. Never commit real secrets.

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://bluechain:bluechain@localhost:5432/bluechain_mrv?schema=public
POSTGRES_USER=bluechain
POSTGRES_PASSWORD=bluechain
POSTGRES_DB=bluechain_mrv

# ─── API (Express) ──────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# ─── Web (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_APP_NAME=BlueChain MRV
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_AI_URL=http://localhost:8000
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com

# ─── AI (FastAPI) ───────────────────────────────────────
AI_HOST=0.0.0.0
AI_PORT=8000
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ─── IPFS (Phase 8+) ────────────────────────────────────
IPFS_PROVIDER=pinata
IPFS_API_URL=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
PINATA_JWT=

# ─── Blockchain (Phase 8+) ──────────────────────────────
PRIVATE_KEY=
REGISTRY_CONTRACT_ADDRESS=
CREDIT_CONTRACT_ADDRESS=
RETIREMENT_CONTRACT_ADDRESS=
