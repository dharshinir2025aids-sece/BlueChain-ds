{
  "name": "bluechain-mrv",
  "version": "0.1.0",
  "private": true,
  "description": "Blockchain-Based Blue Carbon Registry and MRV System",
  "scripts": {
    "dev": "pnpm --parallel --filter @bluechain/web --filter @bluechain/api dev",
    "dev:web": "pnpm --filter @bluechain/web dev",
    "dev:api": "pnpm --filter @bluechain/api dev",
    "dev:ai": "pnpm --filter @bluechain/ai dev",
    "dev:all": "pnpm --parallel --filter @bluechain/web --filter @bluechain/api --filter @bluechain/ai dev",
    "build": "pnpm --filter @bluechain/shared build && pnpm --filter @bluechain/api build && pnpm --filter @bluechain/web build",
    "build:shared": "pnpm --filter @bluechain/shared build",
    "lint": "pnpm -r --filter \"!@bluechain/ai\" lint",
    "db:generate": "pnpm --filter @bluechain/api db:generate",
    "db:migrate": "pnpm --filter @bluechain/api db:migrate",
    "db:push": "pnpm --filter @bluechain/api db:push",
    "db:studio": "pnpm --filter @bluechain/api db:studio"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9"
}
